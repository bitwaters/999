{
  "tick_seconds": 60,
  "gmgn": {
    "minimum_interval_ms": 5000,
    "trending_intervals": ["1m", "5m"],
    "trending_limit": 20,
    "hot_search_interval": "1m",
    "hot_search_every_ticks": 2,
    "hot_search_limit": 20,
    "trenches_every_ticks": 2,
    "trenches_limit": 20
  },
  "coingecko": {
    "index_check_every_ticks": 1,
    "index_retry_initial_seconds": 60,
    "index_retry_max_seconds": 600,
    "pool_snapshot_every_ticks": 2,
    "usage_check_every_ticks": 30,
    "pending_ttl_minutes": 30,
    "active_pool_ttl_minutes": 120,
    "max_tokens_per_chain": 50,
    "max_pools_per_chain": 50,
    "enforce_minimum_remaining_credits": false,
    "minimum_remaining_credits": 100000
  },
  "websocket": {
    "enabled": true,
    "burst_every_ticks": 60,
    "burst_seconds": 20,
    "pools_per_chain": 1,
    "channels": ["G2", "G3"]
  },
  "storage": {
    "directory": "sampling-data",
    "database": "sampling.sqlite",
    "status": "status.json",
    "log": "sampler.log",
    "pid": "sampler.pid"
  }
}
