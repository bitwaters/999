{
  "name": "meme-signal-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "config:validate": "node --import tsx src/app/validate-config.ts",
    "health:check": "node --import tsx src/app/healthcheck.ts",
    "bot:run": "node --import tsx src/app/main.ts",
    "replay:report": "node scripts/replay-report.mjs",
    "sampling:run": "node scripts/continuous-sampler.mjs",
    "provider:contract": "node --import tsx src/providers/contract-check.ts",
    "sampling:audit": "node scripts/sampling-audit.mjs",
    "sampling:review": "node scripts/sampling-review.mjs",
    "provider:gmgn-load": "node scripts/gmgn-load-check.mjs",
    "format": "prettier --write package.json tsconfig.json tsconfig.build.json eslint.config.mjs .prettierrc.json config src",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.build.json eslint.config.mjs .prettierrc.json config src",
    "lint": "eslint .",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "decimal.js": "^10.6.0",
    "gmgn-cli": "^1.5.6",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.7.4",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
